{
  "name": "terminator-survivors",
  "version": "1.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:icons": "node scripts/build-icons.mjs",
    "prepare-assets": "node scripts/generate-pwa-icons.mjs",
    "dev": "vite",
    "build": "node scripts/generate-pwa-icons.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --host",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run test:unit"
  },
  "dependencies": {
    "@fontsource/share-tech-mono": "^5.1.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@iconify-json/game-icons": "^1.2.4",
    "@playwright/test": "^1.48.2",
    "@types/node": "^26.6.5",
    "@types/three": "^0.170.0",
    "@vitest/coverage-v8": "^2.1.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^25.0.1",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^2.1.5"
  }
}
